# LifeLog local secrets.
# A real environment variable always overrides anything set here.
# This file is gitignored - never commit it.

# Config profile: development | production | test
LIFELOG_ENV=development

# ---- Google OAuth ----
GOOGLE_REDIRECT_URI=https://pouch-lark-series.ngrok-free.dev/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# The Gmail account to sign in as. When set, Google skips the
# "choose an account" page and signs straight into this account.
# Leave empty to let Google show the account chooser the first time;
# the server then remembers the account for later logins.
GOOGLE_ACCOUNT_EMAIL=

# ---- OpenRouter ----
OPENROUTER_API_KEY=your-openrouter-api-key

# ---- Web frontend ----
FRONTEND_URL=https://pouch-lark-series.ngrok-free.dev

# ---- Optional ----
# LIFELOG_PROFILE=production
# LIFELOG_SUMMARY_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# LIFELOG_SUMMARY_INTERVAL=3600
# LIFELOG_SUMMARY_WINDOW=3600
# LIFELOG_SUMMARY_RETENTION_DAYS=30
# LIFELOG_SUMMARY_DAILY_BUDGET=50
# LIFELOG_SUMMARY_WEBHOOK_URL=
# LIFELOG_DB_PATH=lifelog.db
# LIFELOG_STORAGE_DIR=uploads
